<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Rider Fuel Adjustment</title>

<!-- SheetJS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f6f8;
    color: #1f2937;
}

header {
    background: #111827;
    color: white;
    padding: 22px 15px;
    text-align: center;
}

header h1 {
    margin: 0;
    font-size: 26px;
}

header p {
    margin: 8px 0 0;
    color: #d1d5db;
    font-size: 14px;
}

.container {
    max-width: 1250px;
    margin: auto;
    padding: 20px;
}

.card {
    background: white;
    border-radius: 12px;
    padding: 22px;
    margin-bottom: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,.08);
}

.card h2 {
    margin-top: 0;
}

.upload-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
}

.upload-box {
    border: 2px dashed #cbd5e1;
    padding: 20px;
    border-radius: 10px;
    background: #f8fafc;
}

.upload-box label {
    display: block;
    font-weight: bold;
    margin-bottom: 10px;
}

.upload-box small {
    display: block;
    margin-top: 10px;
    color: #64748b;
    line-height: 1.5;
}

input[type="file"],
input[type="number"] {
    width: 100%;
    padding: 10px;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
}

.settings {
    display: flex;
    gap: 15px;
    align-items: end;
    flex-wrap: wrap;
    margin-top: 20px;
}

.rate-box {
    width: 200px;
}

button {
    border: none;
    padding: 12px 20px;
    border-radius: 7px;
    cursor: pointer;
    font-weight: bold;
    font-size: 15px;
}

.primary-btn {
    background: #2563eb;
    color: white;
}

.success-btn {
    background: #16a34a;
    color: white;
}

.secondary-btn {
    background: #64748b;
    color: white;
}

button:hover {
    opacity: .9;
}

.message {
    display: none;
    margin-top: 15px;
    padding: 12px;
    border-radius: 7px;
}

.message.success {
    display: block;
    background: #dcfce7;
    color: #166534;
}

.message.error {
    display: block;
    background: #fee2e2;
    color: #991b1b;
}

.table-wrapper {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}

th,
td {
    border: 1px solid #d1d5db;
    padding: 10px;
    text-align: center;
}

th {
    background: #111827;
    color: white;
    white-space: nowrap;
}

td {
    white-space: nowrap;
}

td input {
    width: 110px;
    padding: 7px;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    text-align: center;
}

.total-row {
    background: #e5e7eb;
    font-weight: bold;
}

.rider-select {
    margin-top: 20px;
}

.rider-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 10px;
    margin-top: 15px;
    max-height: 350px;
    overflow-y: auto;
    padding: 10px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

.rider-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px;
    background: #f8fafc;
    border-radius: 6px;
    cursor: pointer;
}

.rider-item input {
    width: auto;
}

.actions {
    margin-top: 20px;
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
}

.info {
    font-size: 14px;
    color: #64748b;
    line-height: 1.5;
}

@media(max-width:600px) {

    .container {
        padding: 12px;
    }

    .card {
        padding: 15px;
    }

    header h1 {
        font-size: 21px;
    }
}
</style>
</head>

<body>

<header>
    <h1>Rider Fuel Adjustment</h1>
    <p>Count rider orders and calculate fuel amount automatically</p>
</header>


<div class="container">


<!-- UPLOAD -->

<div class="card">

    <h2>Upload Files</h2>

    <div class="upload-grid">


        <!-- ORDER FILE -->

        <div class="upload-box">

            <label>
                📋 Order List
                <span style="color:red">*</span>
            </label>

            <input
                type="file"
                id="orderFile"
                accept=".xlsx,.xls,.csv"
            >

            <small>
                Required. Upload the daily Order List.
                The tool will detect the Rider or Assigned To column.
            </small>

        </div>


        <!-- OPTIONAL RIDER FILE -->

        <div class="upload-box">

            <label>
                👤 Rider Template
                <span style="color:#64748b">(Optional)</span>
            </label>

            <input
                type="file"
                id="riderFile"
                accept=".xlsx,.xls,.csv"
            >

            <small>
                Optional. Upload any rider template containing
                ID and Name columns. No example riders are
                permanently stored in this tool.
            </small>

        </div>


    </div>


    <div class="settings">

        <div class="rate-box">

            <label>
                <strong>Fuel Per Order (Rs.)</strong>
            </label>

            <br><br>

            <input
                type="number"
                id="fuelRate"
                value="61"
                min="0"
            >

        </div>


        <button
            class="primary-btn"
            onclick="processFiles()"
        >
            Process Orders
        </button>

    </div>


    <div id="message" class="message"></div>

</div>


<!-- RIDER SELECTION -->

<div
    class="card"
    id="selectionCard"
    style="display:none"
>

    <h2>Select Riders</h2>

    <p class="info">
        Select the riders you want to include in the final output.
    </p>


    <div class="actions">

        <button
            class="secondary-btn"
            onclick="selectAllRiders()"
        >
            Select All
        </button>


        <button
            class="secondary-btn"
            onclick="clearRiderSelection()"
        >
            Clear All
        </button>

    </div>


    <div
        class="rider-list"
        id="riderSelection"
    ></div>


    <div class="actions">

        <button
            class="primary-btn"
            onclick="calculateAdjustment()"
        >
            Calculate Adjustment
        </button>

    </div>

</div>


<!-- RESULTS -->

<div
    class="card"
    id="resultCard"
    style="display:none"
>

    <h2>Fuel Adjustment Result</h2>


    <div class="table-wrapper">

        <table>

            <thead>

                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>No. of Order</th>
                    <th>Order Amount</th>
                    <th>Other Amount</th>
                    <th>Grave yard order amount</th>
                    <th>Total Amount</th>
                </tr>

            </thead>


            <tbody id="resultBody"></tbody>


            <tfoot id="resultFooter"></tfoot>

        </table>

    </div>


    <div class="actions">

        <button
            class="success-btn"
            onclick="downloadExcel()"
        >
            ⬇ Download Excel
        </button>

    </div>

</div>


</div>


<script>


/* =====================================
   GLOBAL VARIABLES
===================================== */

let orderData = [];

let riders = [];

let finalData = [];


/* =====================================
   NORMALIZE TEXT
===================================== */

function normalizeText(value) {

    if (
        value === undefined ||
        value === null
    ) {
        return "";
    }

    return String(value)

        .toLowerCase()

        .replace(/\s+/g, " ")

        .trim();

}


/* =====================================
   NORMALIZE COLUMN
===================================== */

function normalizeColumn(value) {

    return String(value || "")

        .toLowerCase()

        .replace(/[^a-z0-9]/g, "");

}


/* =====================================
   SHOW MESSAGE
===================================== */

function showMessage(text, type) {

    const message =
        document.getElementById("message");

    message.textContent = text;

    message.className =
        "message " + type;

}


/* =====================================
   READ EXCEL
===================================== */

function readExcel(file) {

    return new Promise(
        (resolve, reject) => {

            const reader =
                new FileReader();


            reader.onload = event => {

                try {

                    const workbook =
                        XLSX.read(
                            event.target.result,
                            {
                                type: "array"
                            }
                        );


                    const sheetName =
                        workbook.SheetNames[0];


                    const sheet =
                        workbook.Sheets[sheetName];


                    const data =
                        XLSX.utils.sheet_to_json(
                            sheet,
                            {
                                defval: ""
                            }
                        );


                    resolve(data);

                }

                catch (error) {

                    reject(error);

                }

            };


            reader.onerror = reject;


            reader.readAsArrayBuffer(file);

        }
    );

}


/* =====================================
   FIND COLUMN
===================================== */

function findColumn(
    row,
    possibleColumns
) {

    const keys =
        Object.keys(row);


    for (
        const name
        of possibleColumns
    ) {

        const target =
            normalizeColumn(name);


        const found =
            keys.find(key =>
                normalizeColumn(key)
                === target
            );


        if (found) {

            return found;

        }

    }


    return null;

}


/* =====================================
   GET ORDER RIDER COLUMN
===================================== */

function getOrderRider(row) {

    const column =
        findColumn(
            row,
            [
                "Rider",
                "Rider Name",
                "Assigned To",
                "AssignedTo"
            ]
        );


    if (!column) {

        return "";

    }


    return row[column];

}


/* =====================================
   GET ID
===================================== */

function getRiderID(row) {

    const column =
        findColumn(
            row,
            [
                "ID",
                "Rider ID",
                "RiderID"
            ]
        );


    return column
        ? row[column]
        : "";

}


/* =====================================
   GET NAME
===================================== */

function getRiderName(row) {

    const column =
        findColumn(
            row,
            [
                "Name",
                "Rider Name",
                "RiderName",
                "Rider"
            ]
        );


    return column
        ? row[column]
        : "";

}


/* =====================================
   PROCESS FILES
===================================== */

async function processFiles() {

    const orderFile =
        document
        .getElementById("orderFile")
        .files[0];


    const riderFile =
        document
        .getElementById("riderFile")
        .files[0];


    if (!orderFile) {

        showMessage(
            "Please upload the Order List.",
            "error"
        );

        return;

    }


    try {

        showMessage(
            "Reading files...",
            "success"
        );


        /* READ ORDER FILE */

        orderData =
            await readExcel(orderFile);


        if (
            orderData.length === 0
        ) {

            throw new Error(
                "Order List is empty."
            );

        }


        riders = [];


        /* =================================
           OPTIONAL RIDER TEMPLATE
        ================================= */

        if (riderFile) {

            const riderFileData =
                await readExcel(riderFile);


            riderFileData.forEach(
                row => {

                    const id =
                        getRiderID(row);


                    const name =
                        getRiderName(row);


                    if (name) {

                        riders.push({

                            id: id,

                            name: name,

                            key:
                                normalizeText(name)

                        });

                    }

                }
            );

        }


        /* =================================
           NO TEMPLATE:
           DETECT RIDERS FROM ORDER LIST
        ================================= */

        else {

            const uniqueRiders =
                new Map();


            orderData.forEach(
                row => {

                    const name =
                        getOrderRider(row);


                    const key =
                        normalizeText(name);


                    if (
                        name &&
                        key
                    ) {

                        if (
                            !uniqueRiders.has(key)
                        ) {

                            uniqueRiders.set(
                                key,
                                name
                            );

                        }

                    }

                }
            );


            uniqueRiders.forEach(
                (name, key) => {

                    riders.push({

                        id: "",

                        name: name,

                        key: key

                    });

                }
            );

        }


        if (
            riders.length === 0
        ) {

            throw new Error(
                "No riders were found."
            );

        }


        renderRiderSelection();


        document
            .getElementById(
                "selectionCard"
            )
            .style.display =
            "block";


        document
            .getElementById(
                "resultCard"
            )
            .style.display =
            "none";


        showMessage(
            `${riders.length} riders found successfully.`,
            "success"
        );

    }


    catch (error) {

        console.error(error);


        showMessage(
            error.message,
            "error"
        );

    }

}


/* =====================================
   RENDER RIDER SELECTION
===================================== */

function renderRiderSelection() {

    const container =
        document.getElementById(
            "riderSelection"
        );


    container.innerHTML = "";


    riders.forEach(
        (rider, index) => {

            const label =
                document.createElement(
                    "label"
                );


            label.className =
                "rider-item";


            label.innerHTML = `

                <input
                    type="checkbox"
                    class="rider-checkbox"
                    data-index="${index}"
                    checked
                >

                <span>
                    ${
                        rider.id
                        ? rider.id + " - "
                        : ""
                    }

                    ${rider.name}
                </span>

            `;


            container.appendChild(
                label
            );

        }
    );

}


/* =====================================
   SELECT ALL
===================================== */

function selectAllRiders() {

    document
        .querySelectorAll(
            ".rider-checkbox"
        )
        .forEach(
            checkbox => {

                checkbox.checked = true;

            }
        );

}


/* =====================================
   CLEAR ALL
===================================== */

function clearRiderSelection() {

    document
        .querySelectorAll(
            ".rider-checkbox"
        )
        .forEach(
            checkbox => {

                checkbox.checked = false;

            }
        );

}


/* =====================================
   CALCULATE ADJUSTMENT
===================================== */

function calculateAdjustment() {

    const fuelRate =
        Number(
            document
            .getElementById(
                "fuelRate"
            )
            .value
        ) || 61;


    const selectedIndexes =
        [];


    document
        .querySelectorAll(
            ".rider-checkbox"
        )
        .forEach(
            checkbox => {

                if (
                    checkbox.checked
                ) {

                    selectedIndexes.push(
                        Number(
                            checkbox.dataset.index
                        )
                    );

                }

            }
        );


    if (
        selectedIndexes.length === 0
    ) {

        alert(
            "Please select at least one rider."
        );

        return;

    }


    /* ================================
       COUNT ORDERS
    ================================ */

    const orderCount = {};


    orderData.forEach(
        row => {

            const riderName =
                normalizeText(
                    getOrderRider(row)
                );


            if (!riderName) {

                return;

            }


            orderCount[riderName] =
                (
                    orderCount[riderName]
                    || 0
                )
                + 1;

        }
    );


    /* ================================
       CREATE RESULT
    ================================ */

    finalData = [];


    selectedIndexes.forEach(
        index => {

            const rider =
                riders[index];


            const orders =
                orderCount[
                    rider.key
                ]
                || 0;


            const orderAmount =
                orders
                * fuelRate;


            finalData.push({

                id: rider.id,

                name: rider.name,

                orders: orders,

                orderAmount:
                    orderAmount,

                otherAmount: 0,

                graveYardAmount: 0,

                totalAmount:
                    orderAmount

            });

        }
    );


    renderResult();


    document
        .getElementById(
            "resultCard"
        )
        .style.display =
        "block";


    document
        .getElementById(
            "resultCard"
        )
        .scrollIntoView({

            behavior: "smooth"

        });

}


/* =====================================
   RENDER RESULT
===================================== */

function renderResult() {

    const body =
        document.getElementById(
            "resultBody"
        );


    body.innerHTML = "";


    finalData.forEach(
        (item, index) => {

            const row =
                document.createElement(
                    "tr"
                );


            row.innerHTML = `

                <td>
                    ${item.id}
                </td>

                <td>
                    ${item.name}
                </td>

                <td>
                    ${item.orders}
                </td>

                <td>
                    ${formatNumber(
                        item.orderAmount
                    )}
                </td>


                <td>

                    <input
                        type="number"
                        value="${item.otherAmount}"
                        onchange="
                            updateOther(
                                ${index},
                                this.value
                            )
                        "
                    >

                </td>


                <td>

                    <input
                        type="number"
                        value="${item.graveYardAmount}"
                        onchange="
                            updateGraveYard(
                                ${index},
                                this.value
                            )
                        "
                    >

                </td>


                <td
                    id="total-${index}"
                >

                    ${formatNumber(
                        item.totalAmount
                    )}

                </td>

            `;


            body.appendChild(row);

        }
    );


    updateTotals();

}


/* =====================================
   UPDATE OTHER AMOUNT
===================================== */

function updateOther(
    index,
    value
) {

    finalData[index]
        .otherAmount =
        Number(value)
        || 0;


    updateRowTotal(index);


    updateTotals();

}


/* =====================================
   UPDATE GRAVE YARD
===================================== */

function updateGraveYard(
    index,
    value
) {

    finalData[index]
        .graveYardAmount =
        Number(value)
        || 0;


    updateRowTotal(index);


    updateTotals();

}


/* =====================================
   UPDATE ROW TOTAL
===================================== */

function updateRowTotal(index) {

    const item =
        finalData[index];


    item.totalAmount =

        item.orderAmount

        + item.otherAmount

        + item.graveYardAmount;


    document
        .getElementById(
            `total-${index}`
        )
        .textContent =
        formatNumber(
            item.totalAmount
        );

}


/* =====================================
   UPDATE TOTALS
===================================== */

function updateTotals() {

    const totalOrders =
        finalData.reduce(
            (sum, item) =>
                sum + item.orders,
            0
        );


    const totalOrderAmount =
        finalData.reduce(
            (sum, item) =>
                sum
                + item.orderAmount,
            0
        );


    const totalOther =
        finalData.reduce(
            (sum, item) =>
                sum
                + item.otherAmount,
            0
        );


    const totalGraveYard =
        finalData.reduce(
            (sum, item) =>
                sum
                + item.graveYardAmount,
            0
        );


    const grandTotal =
        finalData.reduce(
            (sum, item) =>
                sum
                + item.totalAmount,
            0
        );


    document
        .getElementById(
            "resultFooter"
        )
        .innerHTML = `

            <tr class="total-row">

                <td colspan="2">
                    Total Order
                </td>

                <td>
                    ${formatNumber(
                        totalOrders
                    )}
                </td>

                <td>
                    ${formatNumber(
                        totalOrderAmount
                    )}
                </td>

                <td>
                    ${formatNumber(
                        totalOther
                    )}
                </td>

                <td>
                    ${formatNumber(
                        totalGraveYard
                    )}
                </td>

                <td>
                    ${formatNumber(
                        grandTotal
                    )}
                </td>

            </tr>

        `;

}


/* =====================================
   FORMAT NUMBER
===================================== */

function formatNumber(number) {

    return Number(
        number || 0
    )
    .toLocaleString(
        "en-PK",
        {
            maximumFractionDigits: 0
        }
    );

}


/* =====================================
   DOWNLOAD EXCEL
===================================== */

function downloadExcel() {

    if (
        finalData.length === 0
    ) {

        alert(
            "Please calculate adjustment first."
        );

        return;

    }


    const exportData =
        finalData.map(
            item => ({

                "ID":
                    item.id,

                "Name":
                    item.name,

                "No. of Order":
                    item.orders,

                "Order Amount":
                    item.orderAmount,

                "Other amount":
                    item.otherAmount,

                "Grave yard order amount":
                    item.graveYardAmount,

                "Total Amount":
                    item.totalAmount

            })
        );


    /* TOTALS */

    const totals = {

        "ID":
            "Total Order",

        "Name":
            "",

        "No. of Order":
            finalData.reduce(
                (sum, item) =>
                    sum + item.orders,
                0
            ),

        "Order Amount":
            finalData.reduce(
                (sum, item) =>
                    sum
                    + item.orderAmount,
                0
            ),

        "Other amount":
            finalData.reduce(
                (sum, item) =>
                    sum
                    + item.otherAmount,
                0
            ),

        "Grave yard order amount":
            finalData.reduce(
                (sum, item) =>
                    sum
                    + item.graveYardAmount,
                0
            ),

        "Total Amount":
            finalData.reduce(
                (sum, item) =>
                    sum
                    + item.totalAmount,
                0
            )

    };


    exportData.push(totals);


    /* CREATE SHEET */

    const worksheet =
        XLSX.utils.json_to_sheet(
            exportData
        );


    /* COLUMN WIDTH */

    worksheet["!cols"] = [

        { wch: 15 },

        { wch: 30 },

        { wch: 16 },

        { wch: 18 },

        { wch: 16 },

        { wch: 28 },

        { wch: 18 }

    ];


    /* CREATE WORKBOOK */

    const workbook =
        XLSX.utils.book_new();


    XLSX.utils.book_append_sheet(
        workbook,
        worksheet,
        "Fuel Adjustment"
    );


    /* DATE */

    const date =
        new Date()
        .toISOString()
        .split("T")[0];


    /* DOWNLOAD */

    XLSX.writeFile(
        workbook,
        `Rider_Fuel_Adjustment_${date}.xlsx`
    );

}


</script>

</body>
</html>
